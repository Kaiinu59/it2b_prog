class Animal
{
    public string Name { get; set; }
    public int Weight { get; set; }
    public int Energy = 100;
    public bool Alive = true;
    public string AllowedFood { get; set; }

    public Animal(string name, int weight, string allowedFood)
    {
        Weight = weight;
        Name = name;
        AllowedFood = allowedFood;
    }
}




class Cat : Animal
{
    public Cat(string name) : base(string name, int weight, string allowedFood)
}
